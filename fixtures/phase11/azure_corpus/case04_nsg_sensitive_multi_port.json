{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "category": "NSG_OVER_EXPOSURE",
    "format": "ARM",
    "expected": "SAT",
    "description": "ARM template NSG allowing multi-port range 20-25 (SSH/FTP) from Internet"
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2021-02-01",
      "name": "nsg-multi-port",
      "location": "eastus",
      "properties": {
        "securityRules": [
          {
            "name": "AllowMultiPortRange",
            "properties": {
              "priority": 130,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "20-25",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*"
            }
          }
        ]
      }
    }
  ]
}
