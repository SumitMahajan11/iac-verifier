{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "category": "AZURE_GOVERNANCE_POLICY_VIOLATION",
    "format": "ARM",
    "expected": "SAT",
    "description": "ARM template policy restricting location to EU regions violated by storage account in eastus"
  },
  "resources": [
    {
      "type": "Microsoft.Authorization/policyDefinitions",
      "apiVersion": "2021-06-01",
      "name": "eu-only-location",
      "properties": {
        "policyRule": {
          "if": {
            "field": "location",
            "notIn": ["westeurope", "northeurope"]
          },
          "then": {
            "effect": "Deny"
          }
        }
      }
    },
    {
      "type": "Microsoft.Authorization/policyAssignments",
      "apiVersion": "2021-06-01",
      "name": "location-assignment",
      "properties": {
        "scope": "/subscriptions/sub-policy-2",
        "policyDefinitionId": "eu-only-location"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2021-04-01",
      "name": "stgeastusbad",
      "location": "eastus",
      "properties": {
        "scope": "/subscriptions/sub-policy-2/resourceGroups/rg-storage"
      }
    }
  ]
}
